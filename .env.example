# Base URL of the deployed estimator app (hosts /api/contact → GoHighLevel).
# Local dev: http://localhost:3001 — Production: the estimator's Vercel URL.
VITE_ESTIMATOR_API_URL=

# Web3Forms email notifications (fallback/backup channel for the contact form).
# The key IS the destination: generate it at web3forms.com for
# Esdras@texashighrefinished.com so leads land in the same inbox GHL notifies.
VITE_WEB3FORMS_ACCESS_KEY=
# Extra CC address. Requires a Web3Forms PRO plan — leave empty on the free plan.
VITE_TEST_CC_EMAIL=
