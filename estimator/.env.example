# GoHighLevel private integration (Settings > Private Integrations in the sub-account)
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=
# From GET /opportunities/pipelines — opportunity is skipped if unset
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Verification-visit scheduling (GET /calendars/?locationId=...)
GHL_CALENDAR_ID=
# Pipeline stage to move the opportunity to once a visit is booked
GHL_VISIT_STAGE_ID=

# Emails the owner on every new estimator lead. Sent from the browser — the free
# Web3Forms plan rejects server-side calls (403), so this must stay NEXT_PUBLIC.
# Falls back to the site's existing key; destination inbox is set in Web3Forms.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
